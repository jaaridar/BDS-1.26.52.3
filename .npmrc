# OpenBDS intentionally runs dependency lifecycle scripts OFF.
#
# `bedrock-protocol` pulls in `raknet-native`, a C++ RakNet binding whose
# install script compiles the library with cmake-js. That build is completely
# optional for us: OpenBDS defaults to `jsp-raknet`, the pure-JavaScript
# RakNet implementation, so the server runs with zero native modules.
#
# Skipping scripts also keeps `npm install` working on machines without cmake,
# and hardens installs against malicious dependency scripts.
#
# If you DO want the (faster) native RakNet backend, build it explicitly:
#     npm rebuild raknet-native
# ...then set `openbds-raknet-backend=raknet-native` in server.properties.
ignore-scripts=true
